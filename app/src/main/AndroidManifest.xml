<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <queries>
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.facebook.katana" />
    </queries>
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="Kay's Inspector 2"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:description="@string/app_description">
        <activity android:name="com.kays.friendsuggestions.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.kays.friendsuggestions.SuggestionAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true" android:label="Kay's visible-suggestion scanner">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
